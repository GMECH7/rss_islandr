{
    //  "python.defaultInterpreterPath": "${workspaceFolder}/venv/bin/python"  // macOS/Linux
    "python.defaultInterpreterPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe", // Windows
    //"python.defaultInterpreterPath": "${command:python.interpreterPath}",
    // Optional: Auto-activate the environment on startup
    "python.terminal.activateEnvironment": true,
    "workbench.colorCustomizations": {
        "titleBar.activeBackground": "#3f60a8",
        "statusBar.background": "#3f60a8"
    },
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff"
    },
    "ruff.format.enabled": true,
    "ruff.lineLength": 120,
}